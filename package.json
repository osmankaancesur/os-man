{
  "name": "os-man",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "post": "node scripts/new-post.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "format": "prettier --write \"*.js\" \"*.css\" \"*.html\" \"*.mjs\" \"scripts/*.mjs\" \"server/*.js\" \"db/*.ts\" \"tests/*.mjs\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "engines": {
    "node": "24.x"
  }
}
